# Environment Configuration for SAT-SA (Air-gapped / Local execution)

PROJECT_NAME="SAT-SA — Smart Assessment Tool for Security Analytics"
ENVIRONMENT="development"
DEBUG=true

# Database (Local PostgreSQL or SQLite for local dev testing)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=satsa_user
POSTGRES_PASSWORD=satsa_secure_pass
POSTGRES_DB=satsa_db
# Set DATABASE_URL to override explicit postgres params (e.g., sqlite:///./satsa_dev.db for local dev without postgres docker running)
DATABASE_URL="sqlite:///./satsa_dev.db"

# Security & Auth
SECRET_KEY="sat-sa-supervisory-secret-key-change-in-production-airgap"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# CORS (Frontend origin)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# Ingestion & Analytics
MAX_INGESTION_CHUNK_SIZE_MB=50
ENABLE_LOCAL_NLP=true
